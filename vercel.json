{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "regions": ["bom1"],
  "functions": {
    "src/app/api/quotes/generate-pdf/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/net-metering-sla/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/net-metering-sla",
      "schedule": "0 9 * * *"
    }
  ]
}
