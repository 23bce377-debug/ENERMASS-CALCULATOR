# App Information
NEXT_PUBLIC_APP_NAME=ENERMASS Solar Calculator
NEXT_PUBLIC_COMPANY_NAME=ENERMASS Solar

# Supabase Configurations
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database Connection
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Upstash Redis (Caching/SLA/Rate Limiting)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# Authentication & Cryptography Security
JWT_SECRET=your-jwt-signing-secret
NEXT_PUBLIC_JWT_EXPIRY=your-jwt-expiry-duration (e.g. 7d)
ACTIVATION_KEY_ENCRYPTION_SECRET=your-64-character-hex-secret
