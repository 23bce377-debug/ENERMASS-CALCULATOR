      <strong>{{inr system.totalProjectCost}}</strong>
    </div>
    <div style="display:flex; justify-content:space-between; margin-bottom:4px; font-size:11px;">
      <span>Govt Subsidy Assistance:</span>
      <strong>{{inr system.subsidyAmount}}</strong>
    </div>
    <div style="display:flex; justify-content:space-between; font-size:12px; font-weight:700; border-top:1px solid rgba(0,0,0,0.1); padding-top:4px; margin-top:4px;">
      <span>Net Customer Commitment:</span>
      <strong>{{inr system.beneficiaryContribution}}</strong>
    </div>
  </div>

  <div class="signature-pad" style="margin-top: auto; margin-bottom: var(--sp-6);">
    <div class="signature-pad__col">
      <div style="font-size:11px; font-weight:700; color:var(--ink);">For Enermass Power Solutions Pvt. Ltd.</div>
      <div style="height: 60px; position: relative;">
        {{#if company.ceoSignatureUrl}}
          <img src="{{company.ceoSignatureUrl}}" style="height:55px; position: absolute; left: 0; bottom: 5px; object-fit: contain;" alt="Signature" />
        {{/if}}
      </div>
      <div class="signature-pad__line">
        Authorized Signatory<br/>
        Date: {{formatDate proposal.date}}
      </div>
    </div>
    <div class="signature-pad__col">
      <div style="font-size:11px; font-weight:700; color:var(--ink);">For Customer Acceptance</div>
      <div style="height: 60px;"></div>
      <div class="signature-pad__line">
        Customer Signature &amp; Stamp<br/>
        Name: {{customer.name}}
      </div>
    </div>
  </div>

  <div class="page-footer">
    <div>Proposal Ref: <strong>{{proposal.reference}}</strong> &nbsp;·&nbsp; Prepared for: <strong>{{customer.name}}</strong></div>
    <div>Page 10 of 10</div>
  </div>
</section>

</body>
</html>
